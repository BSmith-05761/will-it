# Backend version
WILLIT_VERSION=0.1.0

# Enable real model streaming for chat (set true/false)
WILLIT_ALLOW_NETWORK=true

WILLIT_STREAM_MODE=responses

WILLIT_STREAM_REASONING=true
WILLIT_MODEL=gpt-5    # a reasoning-capable Responses model
# Your OpenAI API key (required when WILLIT_ALLOW_NETWORK=true)
OPENAI_API_KEY=<secret>

# Optional: override docs directory (for dev)
# WILLIT_DOCS_DIR=/absolute/path/to/will-it/docs

